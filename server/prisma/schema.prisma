generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                    @id @default(uuid())
  username                String
  email                   String                    @unique
  passwordHash            String
  isPrivacyPolicyAccepted Boolean                   @default(false)
  organizationId          String?
  organizationRole        OrganizationRole?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  organization            Organization?             @relation("OrganizationMembers", fields: [organizationId], references: [id], onDelete: SetNull)
  organizationAsOwner     Organization?             @relation("OrganizationOwner")
  createdOrganizations    Organization[]            @relation("OrganizationCreator")
  projectMembers          ProjectMember[]
  createdProjects         Project[]                 @relation("ProjectCreator")
  assignedTickets         Ticket[]                  @relation("TicketAssignee")
  createdTickets          Ticket[]                  @relation("TicketCreator")
  comments Comment[]

  @@index([organizationId])
}

model Organization {
  id           String                    @id @default(uuid())
  orgName      String                    @unique
  description  String?
  ownerId      String                    @unique
  createdById  String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  owner        User                      @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy    User?                     @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members      User[]                    @relation("OrganizationMembers")
  projects     Project[]

  @@index([createdById])
}

model Project {
  id             String   @id @default(uuid())
  organizationId String
  projectKey     String
  projectName    String
  description    String?
  isDefault      Boolean  @default(false)
  createdById    String?
  createdBy      User?           @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  tickets        Ticket[]
  columns        BoardColumn[]
  labels         Label[]
  issueTypes    IssueType[]

  @@unique([organizationId, projectName])
  @@unique([organizationId, projectKey])
}

model BoardColumn {
  id        String   @id @default(uuid())
  projectId String
  name      String
  color     String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets   Ticket[]

  @@index([projectId, position])
  @@unique([projectId, name])
}

model Ticket {
  id          String         @id @default(uuid())
  columnId    String
  projectId   String
  typeId      String?
  ticketKey   String
  title       String
  description Json?
  priority    TicketPriority @default(MEDIUM)
  assigneeId  String?
  position    Int
  storyPoints Int?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  column      BoardColumn    @relation(fields: [columnId], references: [id], onDelete: Restrict)
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issueType   IssueType?     @relation(fields: [typeId], references: [id], onDelete: SetNull)
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User?          @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments Comment[]
  labels      Label[]

  @@unique([projectId, ticketKey])
  @@index([columnId, position])
  @@index([assigneeId])
  @@index([projectId])
  @@index([typeId])
}

model Comment {
  id String @id @default(uuid())
  ticketId String
  userId String
  content Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model ProjectMember {
  id String @id @default(uuid())
  userId String
  projectId String
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@unique([userId, projectId])
  @@index([projectId])
}

model Label {
  id String @id @default(uuid())
  projectId String
  name String
  color String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([projectId, name])
}

model IssueType {
  id        String     @id @default(uuid())
  projectId String
  key       String
  color     String     @default("#c4c4cc")
  isEnabled Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets   Ticket[]

  @@unique([projectId, key])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
