generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  username         String
  email            String            @unique
  passwordHash     String
  organizationId   String?
  organizationRole OrganizationRole?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization         Organization?  @relation("OrganizationMembers", fields: [organizationId], references: [id], onDelete: SetNull)
  organizationAsOwner  Organization?  @relation("OrganizationOwner")
  createdOrganizations Organization[] @relation("OrganizationCreator")
  projectMembers       ProjectMember[]
  @@index([organizationId])
}

model Organization {
  id          String   @id @default(uuid())
  orgName     String   @unique
  ownerId     String   @unique
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner     User      @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   User[]    @relation("OrganizationMembers")
  projects  Project[]
  @@index([createdById])
}

model Project {
  id             String   @id @default(uuid())
  organizationId String
  projectName    String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ProjectMember[]
  @@unique([organizationId, projectName])
}

model ProjectMember {
  id String @id @default(uuid())
  userId String
  projectId String
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([userId, projectId])
  @@index([projectId])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER
}